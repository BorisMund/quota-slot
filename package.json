{
  "name": "quota-slot",
  "version": "0.1.0",
  "description": "Take and give back units of a per-account quota in Postgres, without losing updates under concurrency.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "keywords": [
    "postgres",
    "quota",
    "rate-limit",
    "concurrency",
    "lost-update",
    "read-committed"
  ],
  "author": "Boris Mund",
  "license": "MIT",
  "devDependencies": {
    "@testcontainers/postgresql": "^11.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "pg": "^8.13.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
